# Copier ce fichier en .env (jamais commite) et generer une vraie valeur :
#   cp .env.example .env
#   openssl rand -base64 48   # puis coller le resultat ci-dessous dans .env

APP_JWT_SECRET=

# Mot de passe de la base PostgreSQL locale (docker-compose), partage entre
# le service postgres et la connexion backend. Choisir une valeur locale
# quelconque (pas besoin d'openssl rand ici, ce n'est pas un secret
# cryptographique comme APP_JWT_SECRET, juste un mot de passe DB local).
POSTGRES_PASSWORD=

# Optionnel : active le hook pre-push local (scripts/git-hooks/pre-push) qui
# bloque le push si coverage < 90%, duplication > 0% ou issues SonarCloud
# HIGH/MEDIUM ouvertes. Meme valeur que le secret GitHub Actions SONAR_TOKEN
# (genere sur sonarcloud.io > My Account > Security). Absent = hook ignore
# avec un avertissement, push toujours autorise.
SONAR_TOKEN=

# Optionnel : cree un compte administrateur de demonstration au demarrage du
# backend, uniquement si absent (voir AdminBootstrapRunner). Laisser vide en
# temps normal : aucun compte admin n'est cree, et il n'existe alors aucun
# moyen d'obtenir le role ADMIN via l'API. A ne renseigner que pour preparer
# une demo locale (soutenance), jamais en production.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
