# Copier ce fichier en .env (jamais commite) et generer une vraie valeur :
#   cp .env.example .env
#   openssl rand -base64 48   # puis coller le resultat ci-dessous dans .env

APP_JWT_SECRET=

# Optionnel : active le hook pre-push local (scripts/git-hooks/pre-push) qui
# bloque le push si coverage < 90%, duplication > 0% ou issues SonarCloud
# HIGH/MEDIUM ouvertes. Meme valeur que le secret GitHub Actions SONAR_TOKEN
# (genere sur sonarcloud.io > My Account > Security). Absent = hook ignore
# avec un avertissement, push toujours autorise.
SONAR_TOKEN=
