# Agent tooling (local-only, not part of project source)
.agents/
.codex/
.claude/settings.local.json

# Scratch files provided to Claude as context (subject, grading rubric, etc.)
tmp/*
!tmp/.gitkeep

# Self-signed dev TLS cert (generated locally, never committed)
infra/gateway/certs/*
!infra/gateway/certs/.gitkeep

# Local secrets (real values, never committed; see .env.example for the template)
.env

# Working directory of the local sonar-scanner CLI (hook pre-push)
.scannerwork/

# Generated test/build artifacts (not part of project source)
frontend/test-results/
scripts/git-hooks/__pycache__/
